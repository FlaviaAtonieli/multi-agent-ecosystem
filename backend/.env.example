ENVIRONMENT=development
DATABASE_URL=sqlite:///./agenthub.db
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
ALLOW_REGISTRATION=true
AUTO_CREATE_TABLES=true
BOOTSTRAP_ADMIN_NAME=Administrador Local
BOOTSTRAP_ADMIN_EMAIL=admin@agenthub.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeThis!123456

# Login com GitHub (adicional ao email/senha). Desabilitado por padrao --
# passo a passo pra criar um OAuth App: docs/integrations/github-oauth.md
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
FRONTEND_BASE_URL=http://localhost:5173

# Código de login por e-mail (só em dispositivo/navegador novo).
# EMAIL_BACKEND=console escreve o código no log do backend (dev).
# Para enviar de verdade pelo Gmail: EMAIL_BACKEND=smtp, SMTP_HOST=smtp.gmail.com,
# SMTP_USERNAME=seu@gmail.com, SMTP_PASSWORD=<senha de app>, SMTP_FROM=seu@gmail.com
LOGIN_EMAIL_CODE_ENABLED=true
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
TRUSTED_DEVICE_DAYS=30

# Monitoramento (docs/monitoring.md). /metrics fica aberto em dev; com
# METRICS_TOKEN definido, o scrape exige "Authorization: Bearer <token>".
METRICS_ENABLED=true
METRICS_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

LLM_ENABLED=false
LLM_PROVIDER=mock
# mock -> LLM_MODEL=mock-technical-planner-v1
# openai -> LLM_MODEL=gpt-5-mini (formato direto do fabricante)
# openrouter -> LLM_MODEL=openai/gpt-5-mini (formato vendor/modelo)
LLM_MODEL=gpt-5-mini
LLM_ALLOWED_MODELS=gpt-5-mini,gpt-5,openai/gpt-5-mini,anthropic/claude-sonnet-4.5
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=0
LLM_MAX_INPUT_CHARS=12000
LLM_REQUESTS_PER_HOUR_TECHNICIAN=20
LLM_DAILY_TOKEN_LIMIT_PER_USER=0
LLM_STORE_PROVIDER_RESPONSE=false
LLM_STORE_RESULT_CONTENT=false
LLM_LOG_CONTENT=false
LLM_REDACT_SENSITIVE_DATA=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter: gateway primário de modelos (multiplos providers com uma unica chave).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:5173
