ENVIRONMENT=development
DATABASE_URL=sqlite:///./agenthub.db
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
ALLOW_REGISTRATION=true
AUTO_CREATE_TABLES=true
BOOTSTRAP_ADMIN_NAME=Administrador Local
BOOTSTRAP_ADMIN_EMAIL=admin@agenthub.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeThis!123456

LLM_ENABLED=false
LLM_PROVIDER=mock
# mock -> LLM_MODEL=mock-technical-planner-v1
# openai -> LLM_MODEL=gpt-5-mini (formato direto do fabricante)
# openrouter -> LLM_MODEL=openai/gpt-5-mini (formato vendor/modelo)
LLM_MODEL=gpt-5-mini
LLM_ALLOWED_MODELS=gpt-5-mini,gpt-5,openai/gpt-5-mini,anthropic/claude-sonnet-4.5
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_INPUT_CHARS=12000
LLM_REQUESTS_PER_HOUR_TECHNICIAN=20
LLM_DAILY_TOKEN_LIMIT_PER_USER=150000
LLM_STORE_PROVIDER_RESPONSE=false
LLM_STORE_RESULT_CONTENT=false
LLM_LOG_CONTENT=false
LLM_REDACT_SENSITIVE_DATA=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter: gateway primário de modelos (multiplos providers com uma unica chave).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:5173
