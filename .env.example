# Database used by Docker Compose
POSTGRES_DB=agenthub
POSTGRES_USER=agenthub
POSTGRES_PASSWORD=change-this-database-password

# Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://agenthub:change-this-database-password@db:5432/agenthub
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,backend
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
ALLOW_REGISTRATION=true
AUTO_CREATE_TABLES=false

# Local bootstrap administrator. Change before starting.
BOOTSTRAP_ADMIN_NAME=Administrador Local
BOOTSTRAP_ADMIN_EMAIL=admin@agenthub.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeThis!123456
