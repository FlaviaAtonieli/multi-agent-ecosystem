# Database used by Docker Compose
POSTGRES_DB=agenthub
POSTGRES_USER=agenthub
POSTGRES_PASSWORD=change-this-database-password

# Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://agenthub:change-this-database-password@db:5432/agenthub
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,backend
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
ALLOW_REGISTRATION=true
AUTO_CREATE_TABLES=false

# Local bootstrap administrator. Change before starting.
BOOTSTRAP_ADMIN_NAME=Administrador Local
BOOTSTRAP_ADMIN_EMAIL=admin@agenthub.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeThis!123456

# =========================================================
# LLM integration foundation
# =========================================================
# The project boots without an API key while disabled, but there is no mock
# provider: enabling LLM_ENABLED requires a real OPENROUTER_API_KEY (or
# OPENAI_API_KEY if LLM_PROVIDER=openai).
LLM_ENABLED=false
LLM_PROVIDER=openrouter
# openrouter -> formato vendor/modelo, ex.: openai/gpt-5-mini, anthropic/claude-sonnet-4.5
# openrouter/free models (custo zero, 50 req/dia sem creditos comprados) -> ex.: nvidia/nemotron-3-super-120b-a12b:free
# openai -> LLM_MODEL=gpt-5-mini (formato direto do fabricante)
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_ALLOWED_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-5-mini,anthropic/claude-sonnet-4.5
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_INPUT_CHARS=12000
LLM_REQUESTS_PER_HOUR_TECHNICIAN=20

# Privacy-safe defaults. Keep false unless governance approves storage.
LLM_STORE_PROVIDER_RESPONSE=false
LLM_STORE_RESULT_CONTENT=false
LLM_LOG_CONTENT=false
LLM_REDACT_SENSITIVE_DATA=true

# OpenAI. Leave empty until a project-scoped key is created.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter: primary Model Gateway. A single key routes to many providers/models,
# useful to compare quality/cost/latency without recoding the LLM abstraction.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:5173
