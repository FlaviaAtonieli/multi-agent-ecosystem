# Template de producao (auditoria de seguranca P0/SECURITY.md "Requisitos de
# producao"). Nao e um .env pronto para uso -- todo valor com CHANGE-ME deve
# ser substituido antes de subir. A aplicacao recusa iniciar em
# ENVIRONMENT=production com COOKIE_SECURE=false (ver app/core/config.py).
#
# Pressupoe TLS terminado na frente da aplicacao (nginx/load balancer com
# certificado real) -- COOKIE_SECURE=true sem HTTPS de verdade faz o
# navegador simplesmente descartar os cookies de sessao/CSRF.

# Database used by Docker Compose
POSTGRES_DB=agenthub
POSTGRES_USER=agenthub
POSTGRES_PASSWORD=CHANGE-ME-use-uma-senha-forte-e-unica

# Backend
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://agenthub:CHANGE-ME-mesma-senha-acima@db:5432/agenthub
# Dominio real, sem localhost. Varios dominios separados por virgula se necessario.
CORS_ORIGINS=https://CHANGE-ME.seu-dominio.com
TRUSTED_HOSTS=CHANGE-ME.seu-dominio.com,backend
COOKIE_SECURE=true
SESSION_TTL_HOURS=8
# Considere false apos o cadastro inicial dos usuarios reais -- reduz
# superficie de auto-cadastro nao controlado.
ALLOW_REGISTRATION=false
AUTO_CREATE_TABLES=false

# Credenciais distintas das de desenvolvimento -- nunca reaproveitar.
BOOTSTRAP_ADMIN_NAME=CHANGE-ME
BOOTSTRAP_ADMIN_EMAIL=CHANGE-ME@seu-dominio.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME-use-uma-senha-forte-e-unica

# =========================================================
# LLM integration foundation
# =========================================================
LLM_ENABLED=true
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_ALLOWED_MODELS=nvidia/nemotron-3-super-120b-a12b:free,z-ai/glm-5.2:free,dots-studio/dots-3-note-preview:free,openai/gpt-5-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_INPUT_CHARS=12000
LLM_REQUESTS_PER_HOUR_TECHNICIAN=20
LLM_DAILY_TOKEN_LIMIT_PER_USER=150000

LLM_STORE_PROVIDER_RESPONSE=false
LLM_STORE_RESULT_CONTENT=false
LLM_LOG_CONTENT=false
LLM_REDACT_SENSITIVE_DATA=true

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

OPENROUTER_API_KEY=CHANGE-ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://CHANGE-ME.seu-dominio.com

# Segredo injetado fora do Git (secret manager do provedor de nuvem, variavel
# de ambiente do pipeline de deploy, etc.) -- nunca commitar um .env real,
# de producao ou nao.
